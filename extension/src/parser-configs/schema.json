{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnyTogether parser configs",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "priority", "domains", "pathPatterns", "fields", "seriesContext", "mediaExtraction"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "priority": { "type": "number" },
      "domains": {
        "type": "array",
        "items": { "type": "string" }
      },
      "pathPatterns": {
        "type": "array",
        "items": { "type": "string" }
      },
      "documentExtraction": {
        "type": "object",
        "properties": {
          "backgroundHtml": { "type": "boolean" },
          "domReady": { "type": "boolean" },
          "configuredHtmlWaitMs": { "type": "integer", "minimum": 0 }
        }
      },
      "fields": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "selectors": {
                "type": "array",
                "items": { "type": "string" }
              },
              "paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "patterns": {
                "type": "array",
                "items": { "type": "string" }
              },
              "attribute": { "type": "string" }
            }
          }
        }
      },
      "seriesContext": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "provider": { "type": "string" },
            "resolverPattern": { "type": "string" },
            "resolverCaptures": {
              "type": "object",
              "properties": {
                "itemId": { "type": "integer", "minimum": 1 },
                "translatorId": { "type": "integer", "minimum": 1 },
                "seasonId": { "type": "integer", "minimum": 1 },
                "episodeId": { "type": "integer", "minimum": 1 }
              }
            },
            "contentType": { "type": "string" },
            "favoritesSelector": { "type": "string" },
            "seasons": {
              "type": "object",
              "required": ["selector", "idAttribute"],
              "properties": {
                "selector": { "type": "string" },
                "idAttribute": { "type": "string" }
              }
            },
            "episodes": {
              "type": "object",
              "required": ["selectorTemplate", "idAttribute"],
              "properties": {
                "selectorTemplate": { "type": "string" },
                "idAttribute": { "type": "string" }
              }
            },
            "translators": {
              "type": "object",
              "required": ["selector", "idAttribute"],
              "properties": {
                "selector": { "type": "string" },
                "idAttribute": { "type": "string" },
                "titleAttribute": { "type": "string" }
              }
            },
            "selectors": {
              "type": "array",
              "items": { "type": "string" }
            },
            "seasonSelector": { "type": "string" },
            "episodeSelector": { "type": "string" },
            "translatorSelector": { "type": "string" },
            "valueAttribute": { "type": "string" },
            "activeStylePattern": { "type": "string" },
            "activeSelector": { "type": "string" },
            "seasonValuePattern": { "type": "string" },
            "episodeValuePattern": { "type": "string" },
            "translatorValuePattern": { "type": "string" }
          }
        }
      },
      "directResolvers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "provider", "url", "response"],
          "properties": {
            "type": { "type": "string" },
            "provider": { "type": "string" },
            "method": { "type": "string" },
            "credentials": { "enum": ["omit", "same-origin", "include"] },
            "executionContext": { "enum": ["background", "page"] },
            "url": { "type": "string" },
            "timestampQuery": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "body": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
            },
            "response": {
              "type": "object",
              "required": ["streamListPath"],
              "properties": {
                "streamListPath": { "type": "string" },
                "qualityPath": { "type": "string" },
                "defaultQualityPath": { "type": "string" }
              }
            }
          }
        }
      },
      "mediaExtraction": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "resolverType": { "type": "string" }
          }
        }
      },
      "episodeActivation": {
        "type": "object",
        "properties": {
          "seasonSelectorTemplate": { "type": "string" },
          "episodeSelectorTemplate": { "type": "string" },
          "activeSelector": { "type": "string" },
          "clickDelayMs": { "type": "number" },
          "attempts": { "type": "number" }
        }
      }
    }
  }
}
